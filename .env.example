# -----------------------------------------------------------------------------
# n8n-hubspot-inbound-form-bot-honeypot-shield
# Copy to .env (git-ignored) for the Express middleware, or set the same
# variables on the n8n host. Every credential below is a dummy placeholder.
# Out of the box nothing leaves the machine: DRY_RUN=true, SANDBOX_MODE=true,
# ASN_LOOKUP_PROVIDER=none, and HubSpot/webhook targets are placeholders.
# -----------------------------------------------------------------------------

# --- Safety switches (anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true
# Rejected submissions get the same 200 response as accepted ones
SILENT_REJECT=true

# --- Express server
PORT=3000
# Express "trust proxy" setting: loopback | <number of hops> | <comma-separated proxy IPs/CIDRs> | true | false
TRUST_PROXY=loopback
BODY_LIMIT=64kb
# Comma-separated origins allowed to post (CORS + Origin check), e.g. https://www.example.com
ALLOWED_ORIGINS=
# Bearer token for /admin/quarantine endpoints (24+ characters). Placeholder = admin endpoints disabled.
ADMIN_API_TOKEN=your_admin_api_token_here

# --- Verdict thresholds (risk score 0-100)
QUARANTINE_SCORE_THRESHOLD=40
BLOCK_SCORE_THRESHOLD=80

# --- Honeypot and timing
# Hidden fields that humans never fill (comma-separated field names)
HONEYPOT_FIELDS=website_url,fax_number
FORM_TIMESTAMP_FIELD=_rendered_at
FORM_TOKEN_FIELD=_render_token
# HMAC secret for signed render timestamps (GET /v1/form-token). Placeholder = unsigned timestamps accepted.
FORM_TOKEN_SECRET=your_form_token_secret_here
MIN_FILL_SECONDS=3
MAX_FORM_AGE_SECONDS=7200

# --- Velocity (sliding window)
VELOCITY_WINDOW_SECONDS=600
VELOCITY_MAX_PER_IP=5
VELOCITY_MAX_PER_EMAIL_DOMAIN=15
VELOCITY_MAX_PER_FREEMAIL_DOMAIN=200
VELOCITY_MAX_PER_EMAIL=3

# --- Email
# block | quarantine
DISPOSABLE_EMAIL_ACTION=block
DISPOSABLE_DOMAINS_EXTRA=
ALLOWLIST_EMAIL_DOMAINS=

# --- Free-text heuristics
TEXT_FIELDS_TO_SCORE=firstname,lastname,company,message
MAX_URLS_IN_MESSAGE=2

# --- IP / ASN reputation
# none (no lookups) | header (trusted edge header) | ipinfo (outbound lookup per submission)
ASN_LOOKUP_PROVIDER=none
ASN_HEADER=x-client-asn
ASN_ORG_HEADER=x-client-asn-org
IPINFO_TOKEN=your_ipinfo_token_here
IPINFO_TIMEOUT_MS=1500
DATACENTER_ASNS_EXTRA=
IP_BLOCKLIST_CIDRS=
IP_ALLOWLIST_CIDRS=
# n8n only: header your reverse proxy OVERWRITES with the visitor IP (x-real-ip, cf-connecting-ip, ...).
# The Express server ignores this and uses TRUST_PROXY instead.
CLIENT_IP_HEADER=x-forwarded-for

# --- Browser / UTM
REQUIRE_UTM=false

# --- HubSpot Forms API
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here
HUBSPOT_SANDBOX_PORTAL_ID=your_hubspot_sandbox_portal_id_here
HUBSPOT_FORM_GUID=your_hubspot_form_guid_here
# Optional: comma-separated GUIDs a submission may target via its formGuid field
HUBSPOT_ALLOWED_FORM_GUIDS=
# Optional: Private App token switches to the authenticated /secure/submit endpoint
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_FORMS_BASE_URL=https://api.hsforms.com
HUBSPOT_TIMEOUT_MS=8000
# Only these fields are forwarded to HubSpot (internal property names)
FORWARD_FIELDS=email,firstname,lastname,company,phone,jobtitle,message,website

# --- Quarantine / review log
QUARANTINE_LOG_PATH=data/quarantine.jsonl
QUARANTINE_RETENTION_DAYS=30
# Salt for hashing IPs in review records (required when DRY_RUN=false)
QUARANTINE_HASH_SALT=your_quarantine_hash_salt_here
QUARANTINE_STORE_RAW_IP=false
# Optional HTTPS endpoint (Slack incoming webhook or any JSON receiver) notified per quarantined submission
QUARANTINE_WEBHOOK_URL=your_quarantine_webhook_url_here
